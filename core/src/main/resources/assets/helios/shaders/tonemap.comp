#version 460

// HDR -> display. Output is gamma encoded like Minecraft's own framebuffer contents.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform readonly image2D hdr;
layout(binding = 1, rgba8) uniform writeonly image2D ldr;

layout(push_constant) uniform Push {
    ivec2 size;
    float exposure;
    int pad;
} pc;

// Scale so exposure=1.0 maps mid grey (0.18) to about 0.19 after the curve: ~30% darker than the
// previous tonemapper, which washed out and over-saturated sunlit terrain.
const float BASE_EXPOSURE = 1.3;

// ACES RRT+ODT fit (Stephen Hill). Unlike the simple luminance-only curve, highlights desaturate
// towards white instead of shifting hue (no neon grass).
const mat3 ACES_INPUT = mat3(
    0.59719, 0.07600, 0.02840,
    0.35458, 0.90834, 0.13383,
    0.04823, 0.01566, 0.83777);
const mat3 ACES_OUTPUT = mat3(
     1.60475, -0.10208, -0.00327,
    -0.53108,  1.10813, -0.07276,
    -0.07367, -0.00605,  1.07602);

vec3 rrtAndOdtFit(vec3 v) {
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}

vec3 acesFitted(vec3 color) {
    color = ACES_INPUT * color;
    color = rrtAndOdtFit(color);
    color = ACES_OUTPUT * color;
    return clamp(color, 0.0, 1.0);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    vec3 color = acesFitted(imageLoad(hdr, p).rgb * (pc.exposure * BASE_EXPOSURE));
    imageStore(ldr, p, vec4(pow(color, vec3(1.0 / 2.2)), 1.0));
}
