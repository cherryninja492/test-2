#version 460
#extension GL_EXT_ray_tracing : require
#include "raytracing.glsl"
#include "raygen_common.glsl"

// Lighting probes for entities (which Minecraft rasterizes itself): for each probe position,
// the fraction of sunlight reaching it through terrain, and the depth of water above it.
// Read back by the game to dim entity lighting in shadows and under water.

layout(set = 0, binding = 14, scalar) readonly buffer ProbeInput {
    vec4 probes[];      // xyz relative to the anchor
} probeInput;
layout(set = 0, binding = 15, scalar) writeonly buffer ProbeOutput {
    vec4 results[];     // x sun visibility 0..1, y water depth above (blocks)
} probeOutput;

void main() {
    uint i = gl_LaunchIDEXT.x;
    vec3 p = probeInput.probes[i].xyz;
    uint rng = initRng(uvec2(i, 7u), frame.frameInfo.x);

    float visible = 0.0;
    if (lightIntensity() > 0.0) {
        const vec3 offsets[4] = vec3[](vec3(0.25, 0.4, 0.0), vec3(-0.25, 0.4, 0.0), vec3(0.0, 0.8, 0.25), vec3(0.0, 0.0, -0.25));
        for (int k = 0; k < 4; k++) {
            vec3 l = sampleCone(frame.lightDir.xyz, SUN_ANGULAR_RADIUS, rand2(rng));
            // World geometry only: an entity must not shadow its own probe.
            if (unoccludedMasked(p + offsets[k], l, MAX_DISTANCE, MASK_WORLD)) visible += 0.25;
        }
    }

    float waterDepth = 0.0;
    if (traceSurface(p, vec3(0.0, 1.0, 0.0)) && (hit.material & MAT_WATER) != 0u && hit.t < 64.0) {
        waterDepth = hit.t;
    }
    probeOutput.results[i] = vec4(visible, waterDepth, 0.0, 0.0);
}
