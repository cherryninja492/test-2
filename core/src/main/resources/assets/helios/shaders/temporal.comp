#version 460
#include "common.glsl"

// Temporal accumulation of demodulated illumination (SVGF-style reprojection with bilinear
// taps validated against the previous frame's normal/depth). History length is kept in alpha.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform readonly image2D currentIllumination;
layout(binding = 1, rgba16f) uniform readonly image2D normalDepth;
layout(binding = 2, rgba16f) uniform readonly image2D motionVectors; // xy motion, z expected previous distance
layout(binding = 3, rgba16f) uniform readonly image2D prevNormalDepth;
layout(binding = 4, rgba16f) uniform readonly image2D historyIn;
layout(binding = 5, rgba16f) uniform writeonly image2D historyOut;

layout(push_constant) uniform Push {
    ivec2 size;
    int reset;
    float maxHistory;
} pc;

// Compares the previous frame's surface with where this pixel's surface was expected to be:
// its distance from the previous camera position (not the current one), so moving does not
// throw history away.
bool consistent(vec4 current, float expectedPrevDistance, vec4 previous) {
    bool currentSky = current.w >= SKY_DEPTH * 0.5;
    bool previousSky = previous.w >= SKY_DEPTH * 0.5;
    if (currentSky || previousSky) return currentSky == previousSky;
    return dot(current.xyz, previous.xyz) > 0.9
        && abs(expectedPrevDistance - previous.w) < 0.03 * expectedPrevDistance + 0.05;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;

    vec3 current = imageLoad(currentIllumination, p).rgb;
    vec4 nd = imageLoad(normalDepth, p);
    vec4 motionData = imageLoad(motionVectors, p);
    vec2 motion = motionData.xy;

    vec2 prevPos = vec2(p) + 0.5 + motion * vec2(pc.size) - 0.5;
    ivec2 base = ivec2(floor(prevPos));
    vec2 f = fract(prevPos);

    vec4 sum = vec4(0.0);
    float weightSum = 0.0;
    if (pc.reset == 0) {
        for (int i = 0; i < 4; i++) {
            ivec2 o = ivec2(i & 1, i >> 1);
            ivec2 q = base + o;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, pc.size))) continue;
            if (!consistent(nd, motionData.z, imageLoad(prevNormalDepth, q))) continue;
            float w = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
            sum += imageLoad(historyIn, q) * w;
            weightSum += w;
        }
    }

    vec4 result = vec4(current, 1.0);
    if (weightSum > 1.0e-3) {
        vec4 history = sum / weightSum;
        float count = min(history.a + 1.0, pc.maxHistory);
        result = vec4(mix(history.rgb, current, 1.0 / count), count);
    }
    imageStore(historyOut, p, result);
}
