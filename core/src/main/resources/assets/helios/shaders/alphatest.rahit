#version 460
#extension GL_EXT_ray_tracing : require
#include "raytracing.glsl"

hitAttributeEXT vec2 bary;

// Runs only for non-opaque geometry (cutout blocks and water).
void main() {
    Triangle tri = fetchTriangle(uint(gl_InstanceCustomIndexEXT), uint(gl_GeometryIndexEXT), uint(gl_PrimitiveID));
    bool isShadowRay = (gl_IncomingRayFlagsEXT & gl_RayFlagsTerminateOnFirstHitEXT) != 0u;
    if (isShadowRay && (tri.v0.material & MAT_WATER) != 0u) {
        ignoreIntersectionEXT;
    }
    if (textureLod(blockAtlas, interpolateUv(tri, bary), 0.0).a < 0.5) {
        ignoreIntersectionEXT;
    }
}
