#version 460

// Re-applies the primary surface albedo to the (denoised) illumination.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform readonly image2D illumination;
layout(binding = 1, rgba16f) uniform readonly image2D albedo;
layout(binding = 2, rgba16f) uniform writeonly image2D outColor;

layout(push_constant) uniform Push {
    ivec2 size;
    ivec2 pad;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;
    vec3 color = imageLoad(illumination, p).rgb * imageLoad(albedo, p).rgb;
    imageStore(outColor, p, vec4(color, 1.0));
}
