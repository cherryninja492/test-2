#version 460
#extension GL_EXT_ray_tracing : require
#include "raytracing.glsl"

// Primary visibility, following the camera ray through water (absorption, reflection) and glass
// (refraction, reflection, tint) to the first opaque surface. Per pixel it writes:
//  - direct:   sun/moon light, block light and emission at that surface, demodulated (sharp)
//  - indirect: diffuse path traced bounces, demodulated (denoised)
//  - specular: reflections (water, glass, metal, polished) and in-water scattering, as radiance
// The G-buffer albedo carries the transmittance so modulation darkens what is seen through
// water/glass.

#include "raygen_common.glsl"

layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outIndirect;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D outAlbedo;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D outNormalDepth;
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D outMotion;   // xy motion (uv), z expected previous distance
layout(set = 0, binding = 8, rg32f) uniform writeonly image2D outDepth;     // x opaque surface, y water surface (1 = none)
layout(set = 0, binding = 16, rgba16f) uniform writeonly image2D outWaterVeil; // rgb water light over submerged entities, a transmittance
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D outDirect;
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D outSpecular;

// Point lights (LightGrid): per light two vec4 (position relative to the grid origin + intensity,
// colour); per grid cell (offset, count) into the index list.
layout(set = 0, binding = 11, scalar) readonly buffer Lights { vec4 lights[]; };
layout(set = 0, binding = 12, scalar) readonly buffer LightCells { uvec2 lightCells[]; };
layout(set = 0, binding = 13, scalar) readonly buffer LightIndices { uint lightIndices[]; };

const float FIREFLY_CLAMP = 16.0;
const int MAX_INTERFACES = 8;
const ivec3 LIGHT_GRID_CELLS = ivec3(12, 8, 12);
const int LIGHT_CANDIDATES = 8;
const float POINT_LIGHT_POWER = 5.0;
const float POINT_LIGHT_RANGE = 16.0;
const float WATER_SURFACE_OPACITY = 0.28; // share of the (animated) water texture seen on the surface
const float FLOWING_WATER_OPACITY = 0.6;  // flowing water and waterfalls show more of their texture

bool isClearGlass() {
    return surfaceOf(hit.material) == SURFACE_GLASS && hit.alpha < 0.95;
}

// For secondary rays: skips clear glass texels (no refraction) so glass does not block bounce
// light or reflections.
bool traceOpaque(vec3 origin, vec3 dir) {
    float travelled = 0.0;
    for (int i = 0; i < 4; i++) {
        if (!traceSurface(origin, dir)) return false;
        if (!isClearGlass()) {
            hit.t += travelled;
            return true;
        }
        travelled += hit.t + RAY_EPSILON;
        origin += dir * (hit.t + RAY_EPSILON);
    }
    return false;
}




float pointLightFalloff(float d) {
    return POINT_LIGHT_POWER / (1.0 + 0.3 * d * d) * smoothstep(POINT_LIGHT_RANGE, POINT_LIGHT_RANGE - 5.0, d);
}

// Returns -1 if the point is outside the light grid (use Minecraft's block light instead).
int lightCellOf(vec3 pos) {
    if (frame.lightGrid.w == 0) return -1;
    ivec3 cell = ivec3(floor((pos - vec3(frame.lightGrid.xyz)) / 16.0));
    if (any(lessThan(cell, ivec3(0))) || any(greaterThanEqual(cell, LIGHT_GRID_CELLS))) return -1;
    return (cell.y * LIGHT_GRID_CELLS.z + cell.z) * LIGHT_GRID_CELLS.x + cell.x;
}

// Ray traced light from nearby light-emitting blocks (torches, lanterns, glowstone, lava...):
// resampled importance sampling over the cell's lights, then one shadow ray to the chosen light.
vec3 pointLights(int cellIndex, vec3 pos, vec3 n, uint material, inout uint rng) {
    uvec2 cell = lightCells[cellIndex];
    if (cell.y == 0u) return vec3(0.0);
    vec3 gridPos = pos - vec3(frame.lightGrid.xyz);
    bool foliage = (material & MAT_FOLIAGE) != 0u;
    uint candidates = min(cell.y, uint(LIGHT_CANDIDATES));
    float weightSum = 0.0;
    float chosenWeight = 0.0;
    vec3 chosenContribution = vec3(0.0);
    vec3 chosenPos = vec3(0.0);
    for (uint k = 0u; k < candidates; k++) {
        uint slot = cell.y <= uint(LIGHT_CANDIDATES) ? k : min(uint(rand(rng) * float(cell.y)), cell.y - 1u);
        uint light = lightIndices[cell.x + slot];
        vec4 lp = lights[light * 2u];
        vec3 color = lights[light * 2u + 1u].rgb;
        vec3 toLight = lp.xyz - gridPos;
        float d = length(toLight);
        float ndl = dot(n, toLight / max(d, 1.0e-4));
        if (foliage) ndl = 0.45 + 0.55 * abs(ndl);
        if (ndl <= 0.0 || d > POINT_LIGHT_RANGE) continue;
        vec3 contribution = color * (lp.w * pointLightFalloff(d) * ndl);
        float w = luminance(contribution);
        weightSum += w;
        if (w > 0.0 && rand(rng) * weightSum <= w) {
            chosenWeight = w;
            chosenContribution = contribution;
            chosenPos = lp.xyz;
        }
    }
    if (chosenWeight <= 0.0) return vec3(0.0);
    // Shadow ray towards a jittered point near the light's centre, stopping before its own block.
    vec3 target = chosenPos + (vec3(rand(rng), rand(rng), rand(rng)) - 0.5) * 0.3;
    vec3 toLight = target - gridPos;
    float d = length(toLight);
    vec3 dir = toLight / d;
    vec3 offsetN = dot(n, dir) < 0.0 ? -n : n;
    if (!unoccludedMasked(pos + offsetN * RAY_EPSILON, dir, max(d - 0.55, 0.0), MASK_WORLD)) return vec3(0.0);
    float estimate = cell.y <= uint(LIGHT_CANDIDATES) ? weightSum : weightSum * float(cell.y) / float(candidates);
    return chosenContribution / chosenWeight * estimate;
}

vec3 ambientSky(vec3 dir) {
    return skyRadiance(dir, false) * SKY_AMBIENT;
}

// Indirect (bounced) light arriving at a diffuse surface, without its albedo.
vec3 traceIndirect(vec3 pos, vec3 n, inout uint rng) {
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    uint bounces = frame.frameInfo.y;
    for (uint b = 0u; b < bounces; b++) {
        vec3 origin = pos + n * RAY_EPSILON;
        vec3 dir = sampleCosineHemisphere(n, rand2(rng));
        if (!traceOpaque(origin, dir)) {
            radiance += throughput * ambientSky(dir);
            break;
        }
        pos = origin + dir * hit.t;
        n = hit.normal;
        throughput *= hit.albedo;
        if ((hit.material & MAT_WATER) != 0u) break; // treat water as a dark diffuse surface for GI
        radiance += throughput * (emissionOf(hit.material) + blockLightOf(hit.material) + directLight(pos, n, hit.material, rng));
        if (b >= 1u) {
            float survive = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.05, 0.95);
            if (rand(rng) > survive) break;
            throughput /= survive;
        }
    }
    return radiance;
}

// Radiance seen along a reflected ray (one bounce, shaded without further reflections).
vec3 traceReflection(vec3 origin, vec3 dir, inout uint rng) {
    if (!traceOpaque(origin, dir)) return skyRadiance(dir, false);
    vec3 pos = origin + dir * hit.t;
    vec3 albedo = hit.albedo;
    vec3 n = hit.normal;
    uint material = hit.material;
    return albedo * (emissionOf(material) + blockLightOf(material) + directLight(pos, n, material, rng) + ambientSky(n));
}

// Mirror direction perturbed within a cone (cheap glossy lobe), kept above the surface.
vec3 glossyReflect(vec3 dir, vec3 n, float roughness, inout uint rng) {
    vec3 r = reflect(dir, n);
    vec3 g = sampleCone(r, roughness, rand2(rng));
    return dot(g, n) > 0.0 ? g : r;
}

vec3 fresnelSchlick3(float cosTheta, vec3 f0) {
    return f0 + (1.0 - f0) * pow(1.0 - cosTheta, 5.0);
}

vec3 waterTransmittance(float distance) {
    return exp(-WATER_ABSORPTION * distance);
}

// Light scattered towards the camera inside a water segment: the water's own colour, fading in
// with distance (single-scattering approximation).
vec3 waterInscatter(vec3 segmentTransmittance, vec3 waterAlbedo) {
    vec3 light = SUN_COLOR * (lightIntensity() * SUN_STRENGTH * 0.5) + skyRadiance(vec3(0.0, 1.0, 0.0), false) * SKY_AMBIENT;
    return waterAlbedo * WATER_SCATTER_ALBEDO * light * (1.0 - segmentTransmittance);
}

vec2 motionFromClip(vec4 prevClip, vec2 currentUv) {
    if (prevClip.w <= 1.0e-5) return vec2(2.0); // behind the previous camera: force history rejection
    vec2 prevNdc = prevClip.xy / prevClip.w;
    vec2 prevUv = vec2(prevNdc.x * 0.5 + 0.5, 0.5 - prevNdc.y * 0.5);
    return prevUv - currentUv;
}

float glDepthOf(vec3 pos) {
    vec4 clip = frame.viewProj * vec4(pos, 1.0);
    return clamp(clip.z / clip.w * 0.5 + 0.5, 0.0, 1.0);
}

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    vec2 size = frame.jitter.zw;
    uint rng = initRng(uvec2(pixel), frame.frameInfo.x);

    vec2 ndc = ((vec2(pixel) + 0.5 + frame.jitter.xy) / size) * 2.0 - 1.0;
    ndc.y = -ndc.y;
    vec4 nearH = frame.invViewProj * vec4(ndc, -1.0, 1.0);
    vec4 farH = frame.invViewProj * vec4(ndc, 1.0, 1.0);
    vec3 dir = normalize(farH.xyz / farH.w - nearH.xyz / nearH.w);
    vec3 cameraDir = dir;
    vec2 centerUv = (vec2(pixel) + 0.5) / size;

    // Walk through water and glass interfaces to the first opaque surface.
    bool inWater = (frame.frameInfo.w & FLAG_CAMERA_UNDERWATER) != 0u;
    bool inGlass = false;
    bool throughWater = inWater;
    vec3 origin = frame.cameraPos.xyz;
    vec3 transmittance = vec3(1.0);
    vec3 specular = vec3(0.0);
    vec3 waterAlbedo = DEFAULT_WATER_ALBEDO;
    float interfaceDepth = -1.0;
    float waterSurfaceDepth = 1.0;
    vec4 waterVeil = vec4(0.0, 0.0, 0.0, 1.0);
    bool solid = false;
    for (int i = 0; i < MAX_INTERFACES; i++) {
        bool found = traceSurface(origin, dir);
        if (found && (hit.material & MAT_WATER) != 0u) waterAlbedo = hit.albedo;
        if (inWater) {
            vec3 segment = waterTransmittance(found ? hit.t : 64.0);
            specular += transmittance * waterInscatter(segment, waterAlbedo);
            transmittance *= segment;
        }
        if (!found) break;
        vec3 p = origin + dir * hit.t;
        vec3 n = hit.normal; // faces the incoming ray
        bool water = (hit.material & MAT_WATER) != 0u;
        bool glass = isClearGlass();
        if ((!water && !glass) || i == MAX_INTERFACES - 1) {
            solid = true;
            origin = p;
            break;
        }
        if (interfaceDepth < 0.0) interfaceDepth = glDepthOf(p);
        float cosI = max(dot(-dir, n), 0.0);

        if (water) {
            if (!inWater) {
                vec3 surfaceAlbedo = hit.albedo;
                uint surfaceMaterial = hit.material;
                float opacity = (surfaceMaterial & MAT_FLOWING) != 0u ? FLOWING_WATER_OPACITY : WATER_SURFACE_OPACITY;
                float f = fresnelSchlick(cosI, 0.02);
                vec3 surface = f * traceReflection(p + n * RAY_EPSILON, reflect(dir, n), rng);
                // A share of the animated water texture, lit like a surface (vanilla-like look).
                vec3 surfaceLight = directLight(p, n, surfaceMaterial, rng) + ambientSky(n) + blockLightOf(surfaceMaterial);
                surface += (1.0 - f) * opacity * surfaceAlbedo * surfaceLight;
                float through = (1.0 - f) * (1.0 - opacity);
                specular += transmittance * surface;
                if (waterSurfaceDepth >= 1.0) {
                    // What this water surface adds over entities the game draws beneath it, with a
                    // couple of blocks of absorption for their depth.
                    waterSurfaceDepth = glDepthOf(p);
                    vec3 shallow = waterTransmittance(2.0);
                    waterVeil = vec4(transmittance * (surface + through * waterInscatter(shallow, surfaceAlbedo)),
                                     through * dot(shallow, vec3(0.333)));
                }
                transmittance *= through;
            }
            inWater = !inWater;
            throughWater = true;
            origin = p - n * RAY_EPSILON; // continue on the other side of the surface
            continue;
        }

        // Glass / ice: Fresnel reflection on entry, refraction in and out, tint by the texture.
        float ior = hit.albedo.b > hit.albedo.r * 1.15 && hit.alpha > 0.5 ? ICE_IOR : GLASS_IOR;
        vec3 tint = mix(vec3(1.0), hit.albedo, clamp(hit.alpha * 1.2, 0.0, 1.0));
        if (!inGlass) {
            float f = fresnelSchlick(cosI, 0.04);
            specular += transmittance * f * traceReflection(p + n * RAY_EPSILON, reflect(dir, n), rng);
            transmittance *= (1.0 - f) * tint;
            dir = refract(dir, n, 1.0 / ior);
            inGlass = true;
            origin = p - n * RAY_EPSILON;
        } else {
            vec3 r = refract(dir, n, ior);
            if (dot(r, r) == 0.0) {
                dir = reflect(dir, n); // total internal reflection: stay inside
                origin = p + n * RAY_EPSILON;
            } else {
                dir = r;
                inGlass = false;
                origin = p - n * RAY_EPSILON;
            }
        }
    }

    if (!solid) {
        vec3 sky = inWater ? vec3(0.0) : skyRadiance(dir, false);
        vec4 prevClip = frame.prevViewProj * vec4(cameraDir, 0.0);
        imageStore(outIndirect, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(outDirect, pixel, vec4(min(sky, vec3(FIREFLY_CLAMP * 4.0)), 1.0));
        imageStore(outAlbedo, pixel, vec4(transmittance, 1.0));
        imageStore(outSpecular, pixel, vec4(specular, 1.0));
        imageStore(outNormalDepth, pixel, vec4(0.0, 0.0, 0.0, SKY_DEPTH));
        imageStore(outMotion, pixel, vec4(motionFromClip(prevClip, centerUv), 0.0, 0.0));
        // Pure sky (depth 1) is left to vanilla; sky seen through water/glass is ours.
        imageStore(outDepth, pixel, vec4(interfaceDepth >= 0.0 ? interfaceDepth : 1.0, waterSurfaceDepth, 0.0, 0.0));
        imageStore(outWaterVeil, pixel, waterVeil);
        return;
    }

    vec3 pos = origin;
    vec3 n = hit.normal;
    vec3 albedo = max(hit.albedo, vec3(1.0e-3));
    uint material = hit.material;
    uint surface = surfaceOf(material);
    float distance = length(pos - frame.cameraPos.xyz);
    vec2 motion = motionFromClip(frame.prevViewProj * vec4(pos, 1.0), centerUv);
    float expectedPrevDistance = length(pos - frame.prevCameraPos.xyz);
    // Depth of the opaque surface, so entities behind water and glass stay visible.
    float glDepth = glDepthOf(pos);

    // Glossy surfaces: reflections go to the specular buffer; the diffuse part keeps the rest.
    float cosV = max(dot(-dir, n), 0.0);
    vec3 diffuseWeight = vec3(1.0);
    if (surface == SURFACE_METAL) {
        vec3 f = fresnelSchlick3(cosV, albedo);
        specular += transmittance * f * traceReflection(pos + n * RAY_EPSILON, glossyReflect(dir, n, 0.09, rng), rng);
        diffuseWeight = vec3(0.2);
    } else if (surface == SURFACE_POLISHED) {
        float f = fresnelSchlick(cosV, 0.06);
        specular += transmittance * f * traceReflection(pos + n * RAY_EPSILON, glossyReflect(dir, n, 0.03, rng), rng);
        diffuseWeight = vec3(1.0 - f);
    }

    uint spp = max(frame.frameInfo.z, 1u);
    vec3 indirect = vec3(0.0);
    vec3 direct = vec3(0.0);
    int lightCell = lightCellOf(pos);
    for (uint s = 0u; s < spp; s++) {
        direct += directLight(pos, n, material, rng);
        // Ray traced point lights are noisy with one sample: denoise them with the indirect light.
        if (lightCell >= 0) indirect += pointLights(lightCell, pos, n, material, rng);
        indirect += traceIndirect(pos, n, rng);
    }
    direct = direct / float(spp) + emissionOf(material); // emission = albedo * k -> k
    if (lightCell < 0) direct += blockLightOf(material);
    indirect = min(indirect / float(spp), vec3(FIREFLY_CLAMP));
    // Light reaching a submerged surface crossed the water too (approximated by the view path).
    if (throughWater) transmittance *= transmittance;

    imageStore(outIndirect, pixel, vec4(indirect, 1.0));
    imageStore(outDirect, pixel, vec4(direct, 1.0));
    imageStore(outAlbedo, pixel, vec4(albedo * transmittance * diffuseWeight, 1.0));
    imageStore(outSpecular, pixel, vec4(min(specular, vec3(FIREFLY_CLAMP)), 1.0));
    imageStore(outNormalDepth, pixel, vec4(n, distance));
    imageStore(outMotion, pixel, vec4(motion, expectedPrevDistance, 0.0));
    imageStore(outDepth, pixel, vec4(glDepth, waterSurfaceDepth, 0.0, 0.0));
    imageStore(outWaterVeil, pixel, waterVeil);
}
