#version 460
#include "common.glsl"

// One iteration of an edge-avoiding à-trous wavelet filter (Dammertz et al. 2010) with normal,
// depth and luminance stopping functions. The luminance tolerance shrinks as history accumulates.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform readonly image2D inIllumination;
layout(binding = 1, rgba32f) uniform readonly image2D normalDepth;
layout(binding = 2, rgba16f) uniform writeonly image2D outIllumination;

layout(push_constant) uniform Push {
    ivec2 size;
    int stepSize;
    int pad;
} pc;

const float KERNEL[3] = float[](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) return;

    vec4 center = imageLoad(inIllumination, p);
    vec4 nd = imageLoad(normalDepth, p);
    if (nd.w >= SKY_DEPTH * 0.5) {
        imageStore(outIllumination, p, center);
        return;
    }

    float lumCenter = luminance(center.rgb);
    float sigmaL = 4.0 * (lumCenter + 0.02) / sqrt(max(center.a, 1.0));
    float sigmaZ = (0.02 * nd.w + 0.02) * float(pc.stepSize);

    vec3 sum = vec3(0.0);
    float weightSum = 0.0;
    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            ivec2 q = p + ivec2(dx, dy) * pc.stepSize;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, pc.size))) continue;
            vec4 s = imageLoad(inIllumination, q);
            vec4 snd = imageLoad(normalDepth, q);
            float w = KERNEL[abs(dx)] * KERNEL[abs(dy)];
            w *= pow(max(dot(nd.xyz, snd.xyz), 0.0), 32.0);
            w *= exp(-abs(nd.w - snd.w) / sigmaZ);
            w *= exp(-abs(lumCenter - luminance(s.rgb)) / sigmaL);
            sum += s.rgb * w;
            weightSum += w;
        }
    }
    imageStore(outIllumination, p, vec4(weightSum > 1.0e-6 ? sum / weightSum : center.rgb, center.a));
}
