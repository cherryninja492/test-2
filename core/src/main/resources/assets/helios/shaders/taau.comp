#version 460
#include "common.glsl"

// Built-in temporal upscaler / anti-aliasing, used when DLSS is unavailable. Reprojects the
// display-resolution history with the render-resolution motion vectors and clamps it to the
// variance box of the current frame's neighbourhood (in YCoCg).

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D currentColor;
layout(binding = 1, rgba16f) uniform readonly image2D motionVectors;
layout(binding = 2) uniform sampler2D historyColor;
layout(binding = 3, rgba16f) uniform writeonly image2D historyOut;

layout(push_constant) uniform Push {
    vec2 renderSize;
    vec2 displaySize;
    vec2 jitter;
    int reset;
    float blend;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(p), pc.displaySize))) return;

    vec2 uv = (vec2(p) + 0.5) / pc.displaySize;
    // Render pixel i was sampled at i + 0.5 + jitter: shift to sample the unjittered position.
    vec2 currentUv = uv - pc.jitter / pc.renderSize;
    vec3 current = textureLod(currentColor, currentUv, 0.0).rgb;

    ivec2 maxPixel = ivec2(pc.renderSize) - 1;
    ivec2 rp = clamp(ivec2(currentUv * pc.renderSize), ivec2(0), maxPixel);
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            vec3 c = rgbToYCoCg(texelFetch(currentColor, clamp(rp + ivec2(dx, dy), ivec2(0), maxPixel), 0).rgb);
            m1 += c;
            m2 += c * c;
        }
    }
    vec3 mean = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
    // A tight box snaps the history to the jittered low-resolution frame when upscaling, which
    // shows up as shaking; widen it with the upscale factor.
    float gamma = mix(1.25, 2.25, clamp(pc.displaySize.x / pc.renderSize.x - 1.0, 0.0, 1.0));
    vec3 boxMin = mean - gamma * sigma;
    vec3 boxMax = mean + gamma * sigma;

    vec2 historyUv = uv + imageLoad(motionVectors, rp).xy;
    if (pc.reset != 0 || any(lessThan(historyUv, vec2(0.0))) || any(greaterThan(historyUv, vec2(1.0)))) {
        imageStore(historyOut, p, vec4(current, 1.0));
        return;
    }

    vec3 history = textureLod(historyColor, historyUv, 0.0).rgb;
    history = yCoCgToRgb(clamp(rgbToYCoCg(history), boxMin, boxMax));

    // Blend in a tonemapped space so bright samples do not dominate (reduces flicker).
    float wc = pc.blend / (1.0 + luminance(current));
    float wh = (1.0 - pc.blend) / (1.0 + luminance(history));
    vec3 result = (current * wc + history * wh) / (wc + wh);
    imageStore(historyOut, p, vec4(result, 1.0));
}
